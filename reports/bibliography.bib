@article{meeder_influence_2017,
  title = {The Influence of Slope on Walking Activity and the Pedestrian Modal Share},
  author = {Meeder, Mark and Aebi, Tobias and Weidmann, Ulrich},
  date = {2017-01-01},
  journaltitle = {Transportation Research Procedia},
  shortjournal = {Transportation Research Procedia},
  series = {20th {{EURO Working Group}} on {{Transportation Meeting}}, {{EWGT}} 2017, 4-6 {{September}} 2017, {{Budapest}}, {{Hungary}}},
  volume = {27},
