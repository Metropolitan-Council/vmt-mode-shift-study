@article{furth_network_2016,
  title = {Network {{Connectivity}} for {{Low-Stress Bicycling}}},
  author = {Furth, Peter G. and Mekuria, Maaza C. and Nixon, Hilary},
  date = {2016-01-01},
  journaltitle = {Transportation Research Record},
