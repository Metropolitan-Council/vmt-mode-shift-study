@article{pritchard_bicycle_2019,
  title = {Bicycle {{Level}} of {{Service}} for {{Route Choice}}—{{A GIS Evaluation}} of {{Four Existing Indicators}} with {{Empirical Data}}},
  author = {Pritchard, Ray and Frøyen, Yngve and Snizek, Bernhard},
